# Copy to .env (never commit it). The API reads these; the widget and site never see them.

# At least one model key. With neither, the API runs on the mock model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Random string per deployment; used to hash visitor IPs for the daily limit.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API (overrides bot.config.ts).
# ALLOWED_ORIGINS=https://paulobike.dev,https://ask.paulobike.dev

# Set to 0 to log metrics only, without question text.
LOG_QUESTIONS=1
# LOG_FORMAT=pretty   # pretty (default in a terminal) or json (default otherwise)

# Force the mock model even when keys are set (demos, CI).
# USE_MOCK_MODEL=1

PORT=8787

# --- Build-time settings for the standalone site (apps/site) ---
# VITE_API_URL=https://api.paulobike.dev
# VITE_PORTFOLIO_URL=https://paulobike.dev
# VITE_SOURCE_URL=https://github.com/paulobike/ask-paul
